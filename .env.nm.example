# NM Connect — bloco WAHA_* para subir SEM o WAHA.
#
# O NM Connect usa SÓ a Cloud API oficial da Meta para o WhatsApp. O WAHA
# (WhatsApp Web não oficial) não roda — o serviço fica fora do `up` padrão
# pelo docker-compose.nm.yml. Mas o código do upstream ainda declara estas
# variáveis como `required()` em produção (lib/env.ts): VAZIA, o app não sobe
# ("WAHA_API_BASE_URL é obrigatória em produção"). Por isso elas existem aqui,
# com valores neutros que satisfazem a validação e deixam tudo que é do WAHA
# desligado de forma explícita.
#
# Como usar: copie estas linhas por cima das WAHA_* do .env da instalação.
# Nenhum valor abaixo é segredo. Detalhes: docs/nm/sem-waha.md.

# Não aponta para WAHA nenhum. É um arquivo estático do PRÓPRIO app
# (public/rastreio/v1.js, o script de rastreio que clientes embutem no site —
# caminho estável e servido sem passar pelo proxy de autenticação).
#
# Por que não um endereço qualquer: /api/v1/health concatena "/api/sessions" a
# este valor e faz um GET. Endereço inexistente => checagem "down" => a rota
# responde 503 o tempo todo. O `?sem-waha=` final transforma o sufixo em query
# string ("…/v1.js?sem-waha=/api/sessions"), o app devolve 200 e o health fica
# 200. Consequência a saber: o item "waha" do health vira "ok" e não significa
# nada nesta instalação.
#
# 127.0.0.1 porque quem faz o GET é o próprio contêiner do app (porta 3000).
WAHA_API_BASE_URL=http://127.0.0.1:3000/rastreio/v1.js?sem-waha=

# Este valor exato é o placeholder que o código reconhece como "WAHA não
# configurado" (lib/waha/client.ts, rotas de QR, tela de Conexões, onboarding):
# getWahaClient() devolve null e nada tenta falar com o WAHA. Qualquer outro
# valor faria o app achar que há um WAHA de pé no endereço acima.
WAHA_API_KEY=dev_plaintext_change_me

# Só existe para passar na validação: nenhum código do app lê esta variável.
WAHA_WEBHOOK_BASE_URL=http://app:3000

# Também só passa na validação: nenhum código do app a usa hoje (cifraria
# credenciais de WAHA próprio do cliente). Se o install.sh já gerou uma chave
# aleatória no seu .env, mantenha a dele.
WAHA_BYO_ENCRYPTION_KEY=nao-usada-sem-waha

# Lidas só pelo contêiner do WAHA, que não sobe. Vazias de propósito.
WAHA_API_KEY_SHA512=
WAHA_HMAC_SECRET=
WAHA_WEBHOOK_REQUIRE_SIGNATURE=false
